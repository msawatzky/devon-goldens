---
import Logo from '../components/Logo.astro';

interface Props {
	title?: string;
	noIndex?: boolean;
}

const { title = 'Devon Goldens', noIndex = false } = Astro.props;
const pageTitle = title === 'Devon Goldens' ? title : `${title} | Devon Goldens`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#faf9f6] text-neutral-800 antialiased" data-solid-header={Astro.url.pathname !== '/' ? 'true' : undefined}>

		<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-transparent transition-colors duration-300">
			<div id="header-inner" class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 md:px-10">
				<a href="/#hero" class="flex items-center gap-2.5 text-white transition-colors duration-300" id="header-logo">
					<Logo class="h-10 w-10" width={40} />
					<span class="font-['Playfair_Display'] text-xl font-semibold tracking-tight">Devon Goldens</span>
				</a>
				<nav id="header-nav" class="hidden items-center gap-8 md:flex">
					<a href="/#about" class="header-link text-sm font-medium text-white/90 transition hover:text-white">About</a>
					<a href="/#parents" class="header-link text-sm font-medium text-white/90 transition hover:text-white">Parents</a>
					<a href="/#gallery" class="header-link text-sm font-medium text-white/90 transition hover:text-white">Puppies</a>
					<a href="/#faq" class="header-link text-sm font-medium text-white/90 transition hover:text-white">FAQ</a>
					<a href="/#contact" class="rounded-full bg-white/15 px-5 py-2 text-sm font-medium text-white ring-1 ring-white/30 transition hover:bg-white/25 header-link">Contact</a>
				</nav>
				<button id="mobile-menu-btn" class="flex flex-col gap-1.5 md:hidden" aria-label="Open menu">
					<span class="h-px w-6 bg-white block"></span>
					<span class="h-px w-6 bg-white block"></span>
					<span class="h-px w-4 bg-white block"></span>
				</button>
			</div>

			<div id="mobile-menu" class="hidden bg-white shadow-lg md:hidden">
				<nav class="flex flex-col gap-0 px-6 py-4">
					<a href="/#about" class="mobile-link border-b border-neutral-100 py-3 text-sm font-medium text-neutral-700">About</a>
					<a href="/#parents" class="mobile-link border-b border-neutral-100 py-3 text-sm font-medium text-neutral-700">Parents</a>
					<a href="/#gallery" class="mobile-link border-b border-neutral-100 py-3 text-sm font-medium text-neutral-700">Puppies</a>
					<a href="/#faq" class="mobile-link border-b border-neutral-100 py-3 text-sm font-medium text-neutral-700">FAQ</a>
					<a href="/#contact" class="mobile-link py-3 text-sm font-medium text-neutral-700">Contact</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="border-t border-neutral-200 bg-white py-10">
			<div class="mx-auto flex flex-col items-center gap-3 px-6 text-center md:px-10">
				<a href="/#hero" class="block" aria-label="Devon Goldens home">
					<Logo alt="" class="h-20 w-20 md:h-24 md:w-24" width={96} />
				</a>
				<p class="text-sm text-neutral-500">Purebred Canadian Field line golden retrievers, family raised.</p>
			</div>
		</footer>

	</body>
</html>

<style is:global>
	@import '../styles/global.css';

	html { scroll-behavior: smooth; }

	body {
		font-family: 'Inter', sans-serif;
	}

	h1, h2, h3 {
		font-family: 'Playfair Display', serif;
	}

	#site-header {
		padding-top: env(safe-area-inset-top, 0px);
	}

	#site-header.scrolled {
		background: rgba(255, 255, 255, 0.97);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(0,0,0,0.08);
		box-shadow: 0 1px 16px rgba(0,0,0,0.06);
	}

	#site-header.scrolled #header-logo {
		color: #2f2e17;
	}

	#site-header.scrolled .header-link {
		color: #5E5C2D;
	}

	#site-header.scrolled .header-link:last-child {
		background: #5E5C2D;
		color: white;
		ring-color: transparent;
	}

	#site-header.scrolled #mobile-menu-btn span {
		background: #2f2e17;
	}
</style>

<script>
	const header = document.getElementById('site-header');
	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	const useSolidHeader = document.body.dataset.solidHeader === 'true';

	const updateHeaderScroll = () => {
		if (useSolidHeader || window.scrollY > 60) {
			header?.classList.add('scrolled');
		} else {
			header?.classList.remove('scrolled');
		}
	};

	updateHeaderScroll();
	window.addEventListener('scroll', updateHeaderScroll);

	mobileMenuBtn?.addEventListener('click', () => {
		mobileMenu?.classList.toggle('hidden');
	});

	document.querySelectorAll('.mobile-link').forEach((link) => {
		link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
	});
</script>
